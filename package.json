{
  "name": "groundtruth-systems-site",
  "version": "1.0.0",
  "private": true,
  "description": "GroundTruth Systems website and AWS platform infrastructure",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "jest --runInBand",
    "synth": "cdk synth --strict",
    "validate:site": "node scripts/validate-site.mjs",
    "validate": "npm run build && npm run test && npm run validate:site && npm run synth"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/client-sesv2": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "aws-cdk-lib": "^2.267.0",
    "cdk-nag": "^3.0.2",
    "constructs": "^10.4.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "aws-cdk": "^2.1139.0",
    "esbuild": "^0.25.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.4.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.0"
  }
}
